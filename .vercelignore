# Keep the deployment bundle small. Python has no tree-shaking on Vercel:
# every file reachable at build time ships. The limit is 500 MB uncompressed;
# the Linux bundle is ~280 MB (spaCy, its small model, and the bundled data).
.venv
__pycache__
**/__pycache__
*.pyc

# Dev-only surface — nothing here is imported at runtime.
tests
scripts
.pytest_cache
.ruff_cache

# NB: don't list top-level files here. README.md is needed by the wheel build
# (`readme = "README.md"`), and `vercel deploy --prebuilt` fails with ENOENT on
# any file the traced function references but this list keeps from uploading.
